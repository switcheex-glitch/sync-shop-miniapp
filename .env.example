# Скопируйте в .env.local для локальной разработки и пропишите те же значения в Vercel (Project Settings → Environment Variables).
# ВНИМАНИЕ: SUPABASE_SERVICE_ROLE_KEY, TELEGRAM_BOT_TOKEN, PLATEGA_SECRET, NOTIFY_BOT_TOKEN — серверные секреты, НЕ должны иметь префикс NEXT_PUBLIC_.

# Токен бота-магазина из @BotFather (нужен для проверки подписи initData Telegram и DM покупателю)
TELEGRAM_BOT_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Юзернейм бота поддержки (для кнопки «Поддержка»)
NEXT_PUBLIC_SUPPORT_BOT=Sync_Industries_Support_Bot

# Базовый URL приложения (для PDF/ссылок). По умолчанию https://sync-shop-miniapp.vercel.app
NEXT_PUBLIC_APP_URL=

# === Платёжный шлюз Platega ===
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Необязательно: база API (по умолчанию https://app.platega.io) и URL возврата из платёжки
PLATEGA_API_URL=
PLATEGA_RETURN_URL=https://t.me/Sync_Industries_Shop_bot

# === Бот-уведомитель об оплатах (отдельный бот) ===
NOTIFY_BOT_TOKEN=
# Username владельца, кому слать уведомления (по умолчанию mefr22)
OWNER_USERNAME=mefr22
# Необязательно: запасной chat_id владельца, если не ловить через /start
OWNER_CHAT_ID=
# Необязательно: секрет вебхука бота-уведомителя (если задан — Telegram setWebhook с secret_token)
NOTIFY_WEBHOOK_SECRET=

# === Боты поддержки и модератора (serverless-вебхуки) ===
SUPPORT_BOT_TOKEN=
MODERATOR_BOT_TOKEN=
# ID закрытой админ-группы поддержки (форум-топики)
ADMIN_GROUP_ID=-1004385753979
# Секрет для secret_token вебхуков ботов (Telegram шлёт его в заголовке X-Telegram-Bot-Api-Secret-Token)
BOT_WEBHOOK_SECRET=
# Секрет для /api/cron (внешний пингер cron-job.org передаёт его ?secret=...)
CRON_SECRET=
